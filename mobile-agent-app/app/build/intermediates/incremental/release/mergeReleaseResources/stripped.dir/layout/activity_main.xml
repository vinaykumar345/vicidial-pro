<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_primary"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_header_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vicidial SIM Agent"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textWorkspaceSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/text_gap_small"
                    android:text="Post-login workspace for live customer and call controls"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/buttonExitSession"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap_large"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Back to Login"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSipPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_primary"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIP Phone"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSipStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/text_gap_small"
                    android:text="Not registered"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/input_gap"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonSipRegister"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:backgroundTint="@color/action_primary"
                        android:text="Register"
                        android:textAllCaps="false"
                        android:textColor="@color/action_on_primary" />

                    <Button
                        android:id="@+id/buttonSipUnregister"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/action_secondary"
                        android:text="Unregister"
                        android:textAllCaps="false"
                        android:textColor="@color/action_on_secondary" />
                </LinearLayout>

                <EditText
                    android:id="@+id/editSipDialNumber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/input_gap"
                    android:background="@drawable/bg_input"
                    android:hint="Extension to dial (e.g. 1001)"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/button_gap"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonSipCall"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:backgroundTint="@color/action_primary"
                        android:text="Call"
                        android:textAllCaps="false"
                        android:textColor="@color/action_on_primary" />

                    <Button
                        android:id="@+id/buttonSipHangup"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/action_dark"
                        android:text="Hangup"
                        android:textAllCaps="false"
                        android:textColor="@color/action_on_dark" />

                    <Button
                        android:id="@+id/buttonSipMute"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/action_secondary"
                        android:text="Mute"
                        android:textAllCaps="false"
                        android:textColor="@color/action_on_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCustomerDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_primary"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Details"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/input_gap"
                    android:text="No customer loaded"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCustomerMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/text_gap_small"
                    android:text="Lead and call information appears after login"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textCustomerAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_gap"
                    android:background="@drawable/bg_result"
                    android:padding="@dimen/result_padding"
                    android:text="Address will appear here"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/textCustomerComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/control_gap"
                    android:background="@drawable/bg_result"
                    android:padding="@dimen/result_padding"
                    android:text="Comments will appear here"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAgentFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_primary"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vicidial Agent Features"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/buttonRefreshCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/input_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Refresh Customer Details"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <Button
                    android:id="@+id/buttonPauseAgent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Pause Agent"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <Button
                    android:id="@+id/buttonResumeAgent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Resume Agent"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <Button
                    android:id="@+id/buttonHangupAgent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Hangup Current Call"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <EditText
                    android:id="@+id/editDisposition"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:background="@drawable/bg_input"
                    android:hint="Disposition code, e.g. SALE or CBHOLD"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

                <Button
                    android:id="@+id/buttonSubmitDisposition"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_primary"
                    android:text="Submit Disposition"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_primary" />

                <Button
                    android:id="@+id/buttonLogoutAgent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_dark"
                    android:text="Logout Agent"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_dark" />

                <EditText
                    android:id="@+id/editDtmfDigits"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/section_gap"
                    android:background="@drawable/bg_input"
                    android:hint="DTMF string, use S=* P=# Q=pause"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

                <Button
                    android:id="@+id/buttonSendDtmf"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Send DTMF"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <Button
                    android:id="@+id/buttonParkCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Park Customer"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <Button
                    android:id="@+id/buttonGrabCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Grab Customer"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <EditText
                    android:id="@+id/editTransferNumber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/section_gap"
                    android:background="@drawable/bg_input"
                    android:hint="Transfer or 3-way phone number"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

                <EditText
                    android:id="@+id/editTransferIngroup"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:background="@drawable/bg_input"
                    android:hint="Transfer in-group, e.g. DEFAULTINGROUP"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

                <CheckBox
                    android:id="@+id/checkConsultative"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/button_gap"
                    android:text="Consultative transfer"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/checkDialOverride"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dial override exact number"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/buttonBlindTransfer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_primary"
                    android:text="Blind Transfer"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_primary" />

                <Button
                    android:id="@+id/buttonDialWithCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Dial With Customer"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <Button
                    android:id="@+id/buttonLocalCloser"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Local Closer"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <Button
                    android:id="@+id/buttonLeaveVoicemail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Leave Voicemail"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <Button
                    android:id="@+id/buttonLeave3Way"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Leave 3-Way Call"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSupervisorControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_primary"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Supervisor Controls"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSupervisorHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/text_gap_small"
                    android:text="Unlocked after supervisor login"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editPhoneLogin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:background="@drawable/bg_input"
                    android:hint="Supervisor Phone Login"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

                <EditText
                    android:id="@+id/editSessionId"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:background="@drawable/bg_input"
                    android:hint="Live Session ID"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

                <EditText
                    android:id="@+id/editMonitorServerIp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:background="@drawable/bg_input"
                    android:hint="Vicidial Server IP (for monitor/barge)"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

                <Button
                    android:id="@+id/buttonMonitor"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/control_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Supervisor Monitor"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />

                <Button
                    android:id="@+id/buttonBarge"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/button_gap"
                    android:backgroundTint="@color/action_secondary"
                    android:text="Supervisor Barge"
                    android:textAllCaps="false"
                    android:textColor="@color/action_on_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
