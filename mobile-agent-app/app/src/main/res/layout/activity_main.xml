<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vicidial SIM Agent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editAgentUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Agent User ID"
            android:inputType="text" />

        <EditText
            android:id="@+id/editAgentPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Password"
            android:inputType="textPassword" />

        <Spinner
            android:id="@+id/spinnerCampaign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/editDialNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Number to dial"
            android:inputType="phone" />

        <CheckBox
            android:id="@+id/checkSupervisorMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Supervisor Mode (Monitor/Barge)" />

        <EditText
            android:id="@+id/editPhoneLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Supervisor Phone Login"
            android:visibility="gone"
            android:inputType="text" />

        <EditText
            android:id="@+id/editSessionId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Live Session ID"
            android:visibility="gone"
            android:inputType="number" />

        <EditText
            android:id="@+id/editMonitorServerIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Vicidial Server IP (for monitor/barge)"
            android:visibility="gone"
            android:inputType="text" />

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save Login" />

        <Button
            android:id="@+id/buttonVerifyLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Login to Vicidial" />

        <Button
            android:id="@+id/buttonCallFromSim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Call Using Physical SIM" />

        <Button
            android:id="@+id/buttonVicidialDial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Trigger Vicidial External Dial" />

        <Button
            android:id="@+id/buttonMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="Supervisor Monitor" />

        <Button
            android:id="@+id/buttonBarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="Supervisor Barge" />

        <TextView
            android:id="@+id/textResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Result will appear here" />

        <TextView
            android:id="@+id/textAudit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Audit log:"
            android:textStyle="bold" />
    </LinearLayout>

</ScrollView>
