# Copy this file to .env.production and replace all secrets before starting.

MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
VICIDIAL_DB_NAME=asterisk
VICIDIAL_DB_USER=cron
VICIDIAL_DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD
VICIDIAL_DB_PORT=3306

VICIDIAL_SERVER_IP=127.0.0.1
VICIDIAL_AMI_USER=cron
VICIDIAL_AMI_PASS=CHANGE_ME_STRONG_AMI_PASSWORD

# Backup interval in seconds (default: 6 hours)
BACKUP_INTERVAL_SECONDS=21600

# PHP Control API
APP_API_KEY=CHANGE_ME_CONTROL_API_KEY
VICIDIAL_AGC_API_URL=http://vicidial-web/agc/api.php
VICIDIAL_NON_AGENT_API_URL=http://vicidial-web/vicidial/non_agent_api.php
VICIDIAL_API_USER=6666
VICIDIAL_API_PASS=CHANGE_ME_API_USER_PASSWORD
VICIDIAL_SOURCE=php-control

# Bootstrap defaults applied after DB becomes healthy
VICIDIAL_DEFAULT_AGENT_USER=9885976256
VICIDIAL_DEFAULT_PHONE_PASS=9885976256
VICIDIAL_DEFAULT_CAMPAIGN=TESTCAMP
VICIDIAL_ACTIVE_SERVER_IP=10.10.10.15
