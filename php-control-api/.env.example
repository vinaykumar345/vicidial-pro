APP_API_KEY=change-me

# Vicidial AGC endpoint
VICIDIAL_AGC_API_URL=https://your-domain/agc/api.php

# Optional classic agent login endpoint. If blank, this is inferred from VICIDIAL_AGC_API_URL.
# The mobile APK uses this to create vicidial_live_agents rows visible in realtime reports.
VICIDIAL_AGENT_LOGIN_URL=https://your-domain/agc/vicidial.php

# Vicidial non-agent endpoint
VICIDIAL_NON_AGENT_API_URL=https://your-domain/vicidial/non_agent_api.php

# API-enabled Vicidial user credentials
VICIDIAL_API_USER=6666
VICIDIAL_API_PASS=1234

# Tag written to source field in Vicidial API calls
VICIDIAL_SOURCE=php-control

# Vicidial database for agent credential and campaign resolution
VICIDIAL_DB_HOST=db
VICIDIAL_DB_PORT=3306
VICIDIAL_DB_NAME=asterisk
VICIDIAL_DB_USER=cron
VICIDIAL_DB_PASS=1234
